# Agent API config
API_KEY_NAME=
OPENAI_API_BASE=https://a.fe8.cn/v1
EMBEDDING_API_BASE=https://a.fe8.cn/v1
OPENAI_API_KEY=
EMBEDDING_API_KEY=
MODEL_NAME=deepseek-v4-flash

# Embedding models
EMBEDDING_MODEL_TEXT=text-embedding-v4
EMBEDDING_BATCH_SIZE=10
EMBEDDING_RETRY_COUNT=4
EMBEDDING_RETRY_DELAY_SEC=1.0
RERANK_ENABLED=true
RERANK_MODEL_TEXT=qwen3-rerank
RERANK_API_BASE=https://a.fe8.cn/v1
RERANK_API_KEY=
RERANK_TOPN_FACTOR=4

# Runtime
RAG_RESOURCE_DIR=Resource
RAG_WORK_DIR=./workdir
RAG_EXECUTION_MODE=local
RAG_LOCAL_BASHRC=~/.bashrc
RAG_REMOTE_BASHRC=~/.bashrc
RAG_TED_REQUIRED_COMMANDS=python
RAG_TED_REQUIRED_PY_MODULES=

# Optional SSH mode
RAG_SSH_HOST=
RAG_SSH_USER=
RAG_SSH_PORT=22
RAG_SSH_KEY_PATH=
RAG_REMOTE_WORK_DIR=/tmp/ragagent_tasks

RAG_VECTOR_INDEX_DIR=./workdir/vector_index
